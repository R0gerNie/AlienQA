  "cases": [
    {
      "id": "save-normal",
      "version": "1",
      "family": "save",
      "variant_kind": "normal",
      "entry": "index.html?case=save&variant=1",
      "max_actions": 1,
      "unit": "",
      "reset": "New browser context, reload original entry; no external DB/account",
      "initial_state": "Original entry before any actions; browser-local controlled state",
      "actions": [
        {
          "type": "click",
          "target": {
            "selector": "#save"
          }
        }
      ],
      "assertions": [
        {
          "kind": "text",
          "selector": "#save",
          "value": "Saved"
        }
      ],
      "labels": {
        "sentinel": "EVALUATOR_ONLY_SAVE_NORMAL",
        "known_problem": false,
        "acceptable_alternatives": [
          "visible state update",
          "visible validation",
          "cancelled action"
        ]
      }
    },
